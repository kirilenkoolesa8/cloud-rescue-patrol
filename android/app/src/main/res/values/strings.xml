    <string name="card_cyan_name">CYAN SOUNDING BALLOON</string>
    <string name="card_cyan_log">A standard dusk sounding balloon, cyan envelope, instrument package swinging below.</string>
    <string name="card_cyan_cond">RESCUE YOUR FIRST BALLOON</string>
    <string name="card_amber_name">AMBER SOUNDING BALLOON</string>
    <string name="card_amber_log">Amber envelope, warm layer probe. Rides higher than the cyan sounding balloons.</string>
    <string name="card_amber_cond">COMPLETE ONE MISSION CARD</string>
    <string name="card_violet_name">VIOLET SOUNDING BALLOON</string>
    <string name="card_violet_log">Violet night probe. Rare, slow and worth the detour across two lanes.</string>
    <string name="card_violet_cond">COMPLETE A THREE COLOUR CARD</string>
    <string name="card_mk1_name">PATROL GLIDER MK I</string>
    <string name="card_mk1_log">The training airframe. Forgiving in wind, modest in lift, trusted by every new patrol.</string>
    <string name="card_mk1_cond">CLEAR DAWN PATROL</string>
    <string name="card_mk2_name">LONG WING MK II</string>
    <string name="card_mk2_log">Stretched wings for thermal work. Climbs on columns the Mk I would fly straight through.</string>
    <string name="card_mk2_cond">CLEAR THERMAL ALLEY</string>
    <string name="card_mk3_name">STORM RUNNER MK III</string>
    <string name="card_mk3_log">Reinforced leading edge and a bigger flare bay for the stratosphere ferry runs.</string>
    <string name="card_mk3_cond">CLEAR STRATOSPHERE</string>
    <string name="card_thermal_name">THERMAL COLUMN</string>
    <string name="card_thermal_log">A rising shaft of warm air. Sit inside it and the lift gauge fills in a couple of seconds.</string>
    <string name="card_thermal_cond">CHARGE LIFT TO FULL ONCE</string>
    <string name="card_anvil_name">ANVIL CELL</string>
    <string name="card_anvil_log">The flat topped storm. A beacon flare calms its core long enough to slip past.</string>
    <string name="card_anvil_cond">FIRE FIVE BEACON FLARES</string>
    <string name="card_cirrus_name">NIGHT CIRRUS</string>
    <string name="card_cirrus_log">Ice cloud above the ferry lanes. Only seen by patrols flying a perfect colour chain.</string>
    <string name="card_cirrus_cond">REACH A THREE TIMES STREAK</string>
